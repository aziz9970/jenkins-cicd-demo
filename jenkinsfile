pipeline {
    agent any
environment {
    APP_NAME = 'jenkins-demo'
}
parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'production'],
            description: 'Select environment'
        )
    }

    stages {
        stage('Build') {
            steps {
                echo 'echo "Building ${APP_NAME} application..."'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }
stage('Code Quality') {
            steps {
                echo 'Checking code quality...'
            }
        }

        stage('Deploy') {
when {
    expression {
        params.ENVIRONMENT == 'production'
    }
}
            steps {
                echo 'echo "Deploying ${APP_NAME} to ${params.ENVIRONMENT} environment..."'
            }
        }
    }
}
